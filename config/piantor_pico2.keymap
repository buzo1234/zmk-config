#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

#define BASE 0
#define NAV  1
#define NUM  2
#define SYM  3
#define FUN  4

/ {
    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "Base";
            bindings = <
                &kp TAB           &kp Q             &kp W          &kp E          &kp R          &kp T
                &kp Y             &kp U             &kp I          &kp O          &kp P          &kp BACKSPACE

                &kp LEFT_CONTROL  &kp A             &kp S          &kp D          &kp F          &kp G
                &kp H             &kp J             &kp K          &kp L          &kp SEMICOLON  &kp SINGLE_QUOTE

                &kp LEFT_SHIFT    &kp Z             &kp X          &kp C          &kp V          &kp B
                &kp N             &kp M             &kp COMMA      &kp DOT        &kp SLASH      &kp RIGHT_SHIFT

                &kp LEFT_GUI      &lt NAV BACKSPACE &lt NUM SPACE
                &lt SYM SPACE     &lt FUN ENTER     &kp RIGHT_ALT
            >;
        };

        navigation {
            display-name = "Navigation";
            bindings = <
                &kp ESCAPE        &kp TAB       &kp HOME         &kp UP        &kp END       &kp PAGE_UP
                &kp HOME          &kp PAGE_DOWN &kp PAGE_UP      &kp END       &kp INSERT    &kp DELETE

                &kp LEFT_CONTROL  &kp LEFT_ALT  &kp LEFT_GUI     &kp LEFT_SHIFT &kp CAPSLOCK &kp PAGE_DOWN
                &kp LEFT          &kp DOWN      &kp UP           &kp RIGHT     &kp BACKSPACE &kp DELETE

                &kp ESCAPE        &kp TAB       &kp PRINTSCREEN  &kp INSERT    &kp DELETE    &kp BACKSPACE
                &kp C_PREVIOUS    &kp C_VOL_DN  &kp C_PLAY_PAUSE &kp C_VOL_UP  &kp C_NEXT    &kp C_MUTE

                &trans            &trans        &trans
                &trans            &trans        &trans
            >;
        };

        numbers {
            display-name = "Numbers";
            bindings = <
                &kp ESCAPE        &kp LEFT_PARENTHESIS &kp RIGHT_PARENTHESIS &kp LEFT_BRACKET &kp RIGHT_BRACKET &kp BACKSPACE
                &kp NUMBER_7      &kp NUMBER_8         &kp NUMBER_9          &kp MINUS        &kp SLASH         &kp BACKSPACE

                &kp TAB           &kp LEFT_BRACE       &kp RIGHT_BRACE       &kp ASTERISK     &kp PLUS          &kp EQUAL
                &kp NUMBER_4      &kp NUMBER_5         &kp NUMBER_6          &kp PLUS         &kp ASTERISK      &kp EQUAL

                &kp LEFT_CONTROL  &kp LEFT_ALT         &kp LEFT_GUI          &kp LEFT_SHIFT   &kp COMMA         &kp DOT
                &kp NUMBER_1      &kp NUMBER_2         &kp NUMBER_3          &kp DOT          &kp COMMA         &kp ENTER

                &trans            &trans               &trans
                &kp NUMBER_0      &kp DOT              &kp ENTER
            >;
        };

        symbols {
            display-name = "Symbols";
            bindings = <
                &kp GRAVE         &kp EXCLAMATION &kp AT_SIGN      &kp HASH        &kp DOLLAR       &kp PERCENT
                &kp CARET         &kp AMPERSAND   &kp ASTERISK     &kp LEFT_PARENTHESIS &kp RIGHT_PARENTHESIS &kp BACKSPACE

                &kp TILDE         &kp LESS_THAN   &kp GREATER_THAN &kp LEFT_BRACE  &kp RIGHT_BRACE  &kp PIPE
                &kp UNDERSCORE    &kp PLUS        &kp MINUS        &kp EQUAL       &kp BACKSLASH    &kp SINGLE_QUOTE

                &kp ESCAPE        &kp COMMA       &kp DOT          &kp QUESTION    &kp SLASH        &kp COLON
                &kp LEFT_BRACKET  &kp RIGHT_BRACKET &kp SEMICOLON  &kp COLON       &kp DOUBLE_QUOTES &kp DELETE

                &trans            &trans          &trans
                &trans            &trans          &trans
            >;
        };

        function {
            display-name = "Function";
            bindings = <
                &kp F1            &kp F2       &kp F3          &kp F4       &kp F5       &kp F6
                &kp F7            &kp F8       &kp F9          &kp F10      &kp F11      &kp F12

                &kp ESCAPE        &kp PRINTSCREEN &kp INSERT   &kp DELETE   &kp HOME     &kp END
                &kp C_PREVIOUS    &kp C_VOL_DN &kp C_PLAY_PAUSE &kp C_VOL_UP &kp C_NEXT &kp C_MUTE

                &bootloader       &sys_reset   &none           &none        &none        &none
                &none             &none        &kp C_BRI_DN    &kp C_BRI_UP &sys_reset   &bootloader

                &trans            &trans       &trans
                &trans            &trans       &trans
            >;
        };
    };
};
