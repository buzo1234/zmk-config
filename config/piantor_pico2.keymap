#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE 0
#define NAV  1
#define NUM  2
#define SYM  3
#define FUN  4
#define MOUSE 5

/ {
    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "Base";
            bindings = <
                &kp TAB           &kp Q             &kp W          &kp E          &kp R          &kp T
                &kp Y             &kp U             &kp I          &kp O          &kp P          &kp BACKSPACE

                &kp LEFT_SHIFT  &kp A             &kp S          &kp D          &kp F          &kp G
                &kp H             &kp J             &kp K          &kp L          &kp SEMICOLON  &kp SINGLE_QUOTE

                &kp LEFT_CONTROL    &kp Z             &kp X          &kp C          &kp V          &kp B
                &kp N             &kp M             &kp COMMA      &kp DOT        &kp SLASH      &kp RIGHT_SHIFT

                &lt FUN LEFT_ALT  &lt NAV LEFT_GUI &lt NUM SPACE
                &lt MOUSE SPACE   &lt SYM ENTER     &kp RIGHT_ALT
            >;
        };

        navigation {
            display-name = "Navigation";
            bindings = <
                &kp ESCAPE        &kp TAB       &kp HOME         &kp UP        &kp END       &kp PAGE_UP
                &kp HOME          &kp C_PREVIOUS &kp C_PLAY_PAUSE      &kp C_NEXT       &kp C_VOL_UP    &kp DELETE

                &kp LEFT_CONTROL  &kp LEFT_ALT  &kp LEFT_GUI     &kp LEFT_SHIFT &kp CAPSLOCK &kp PAGE_DOWN
                &kp LEFT          &kp DOWN      &kp UP           &kp RIGHT     &kp C_VOL_DN &kp DELETE

                &kp ESCAPE        &kp TAB       &kp PRINTSCREEN  &kp INSERT    &kp DELETE    &kp BACKSPACE
                &kp C_PREVIOUS    &kp C_VOL_DN  &kp C_PLAY_PAUSE &kp C_VOL_UP  &kp C_MUTE    &kp C_MUTE

                &trans            &trans        &trans
                &trans            &trans        &trans
            >;
        };

        numbers {
            display-name = "Numbers";
            bindings = <
                &kp NUMBER_1      &kp NUMBER_2         &kp NUMBER_3          &kp NUMBER_4      &kp NUMBER_5      &kp NUMBER_6
                &kp NUMBER_7      &kp NUMBER_8         &kp NUMBER_9          &kp NUMBER_0      &kp MINUS         &kp EQUAL

                &kp EXCLAMATION   &kp AT_SIGN          &kp HASH              &kp DOLLAR        &kp PERCENT       &kp CARET
                &kp AMPERSAND     &kp ASTERISK         &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS &kp UNDERSCORE &kp PLUS

                &kp GRAVE         &kp TILDE            &kp LEFT_BRACKET      &kp RIGHT_BRACKET &kp LEFT_BRACE    &kp RIGHT_BRACE
                &kp BACKSLASH     &kp PIPE             &kp COMMA             &kp DOT           &kp SLASH         &kp QUESTION

                &trans            &trans               &trans
                &trans            &trans               &trans
            >;
        };

        symbols {
            display-name = "Symbols";
            bindings = <
                &kp GRAVE         &kp EXCLAMATION &kp AT_SIGN      &kp HASH        &kp DOLLAR       &kp PERCENT
                &kp CARET         &kp AMPERSAND   &kp ASTERISK     &kp LEFT_PARENTHESIS &kp RIGHT_PARENTHESIS &kp BACKSPACE

                &kp TILDE         &kp LESS_THAN   &kp GREATER_THAN &kp LEFT_BRACE  &kp RIGHT_BRACE  &kp PIPE
                &kp UNDERSCORE    &kp PLUS        &kp MINUS        &kp EQUAL       &kp BACKSLASH    &kp SINGLE_QUOTE

                &kp ESCAPE        &kp COMMA       &kp DOT          &kp QUESTION    &kp SLASH        &kp COLON
                &kp LEFT_BRACKET  &kp RIGHT_BRACKET &kp SEMICOLON  &kp COLON       &kp DOUBLE_QUOTES &kp DELETE

                &trans            &trans          &trans
                &trans            &trans          &trans
            >;
        };

        function {
            display-name = "Function";
            bindings = <
                &kp F1            &kp F2       &kp F3          &kp F4       &kp F5       &kp F6
                &kp F7            &kp F8       &kp F9          &kp F10      &kp F11      &kp F12

                &kp ESCAPE        &kp PRINTSCREEN &kp INSERT   &kp DELETE   &kp HOME     &kp END
                &kp C_PREVIOUS    &kp C_VOL_DN &kp C_PLAY_PAUSE &kp C_VOL_UP &kp C_NEXT &kp C_MUTE

                &bootloader       &sys_reset   &none           &none        &none        &none
                &none             &none        &kp C_BRI_DN    &kp C_BRI_UP &sys_reset   &bootloader

                &trans            &trans       &trans
                &trans            &trans       &trans
            >;
        };

        mouse {
            display-name = "Mouse";
            bindings = <
                &none             &none             &none             &none              &none              &none
                &msc SCRL_LEFT    &msc SCRL_DOWN    &msc SCRL_UP      &msc SCRL_RIGHT     &mkp MB4           &mkp MB5

                &none             &none             &none             &none              &none              &none
                &mmv MOVE_LEFT    &mmv MOVE_DOWN    &mmv MOVE_UP      &mmv MOVE_RIGHT     &mkp LCLK          &mkp RCLK

                &none             &none             &none             &none              &none              &none
                &mkp LCLK         &mkp MCLK         &mkp RCLK         &mkp MB4            &mkp MB5           &none

                &none             &none             &none
                &trans            &mkp LCLK         &mkp RCLK
            >;
        };
    };
};
